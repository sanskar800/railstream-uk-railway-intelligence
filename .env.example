# Copy to .env and fill in. Never commit .env.

# Network Rail open data feeds (https://publicdatafeeds.networkrail.co.uk)
# The STOMP login is the same email address and password you use to sign in to the website.
NR_USERNAME=you@example.com
NR_PASSWORD=change-me
NR_STOMP_HOST=publicdatafeeds.networkrail.co.uk
NR_STOMP_PORT=61618

# Always-on capture VM (docs/development.md): used by `make pull-raw`
CAPTURE_HOST=ubuntu@<public-ip>
CAPTURE_SSH_KEY=~/.ssh/railstream_oci

# Local stack (infra/compose): all optional, local-only defaults are used when unset
# POSTGRES_PASSWORD=postgres-local
# LAKEKEEPER_DB_PASSWORD=lakekeeper-local
# LAKEKEEPER_ENCRYPTION_KEY=local-dev-only-not-secret
# S3_ACCESS_KEY=railstream
# S3_SECRET_KEY=railstream-local-secret
